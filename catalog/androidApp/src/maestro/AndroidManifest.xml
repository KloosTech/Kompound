<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The harness deep link: kompound://demo/<id>?theme=dark&font=2.0&... (see HarnessLaunch). Only the maestro build type has it. -->
    <application android:label="Kompound Catalog (Maestro)" tools:replace="android:label">
        <activity android:name=".MainActivity" android:launchMode="singleTask" tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kompound" android:host="demo" />
            </intent-filter>
        </activity>
    </application>
</manifest>
